{
  "name": "codiewebnew",
  "version": "0.1.58",
  "description": "Codie Components",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodieDigital/Codie-Components"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "lint": "eslint \"{**/*,*}.{js,ts,jsx,tsx}\"",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,jsx,tsx}\"",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "awesome-project"
  ],
  "author": "Codie Digital",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.3.2",
    "@types/react": "^18.2.14",
    "@types/styled-components": "^5.1.26",
    "typescript": "^5.1.5"
  },
  "dependencies": {
    "@unform/core": "^2.1.6",
    "@unform/web": "^2.1.6",
    "axios": "^1.4.0",
    "next": "^13.4.4",
    "node": "^22.9.0",
    "nookies": "^2.5.2",
    "path": "^0.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^4.0.10",
    "react-google-recaptcha": "^3.1.0",
    "react-modal": "^3.16.1",
    "react-share": "^5.1.0",
    "styled-components": "^6.0.1",
    "swiper": "^11.1.14",
    "swr": "^2.2.5",
    "yup": "^1.4.0"
  }
}
